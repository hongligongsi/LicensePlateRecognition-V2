# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/

# 测试与工具
.pytest_cache/
# --basetemp=.pytest-tmp 的产物（tmp_path fixture 的根目录，跑完可删，不该入库）
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
.coverage

# 运行产物
annotated/
output/
out/
*.log
logs/

# IDE
.idea/
.vscode/

# 深度学习模型缓存（运行时下载）
~/.rapidocr/

# 数据集与下载缓存
# 图片体积大且可复现（tools/fetch_ccpd.py / tools/fetch_hg.py 重新拉取），不入库
datasets/
_data/
*_cache/

# 全部识别测试图的集中副本（img/ + samples/ + datasets/ccpd_labeled/ 的拷贝，可复现）
images/

# 调参 / 评测产物（可复现，不入库）
reports/

# 调参写入的配置备份
config.json.bak
config.tuned.json

# Agent 工作区
.workbuddy/

# 可选第二识别模型（体积大，按需下载，见 config.EngineConfig.secondary_rec_model）
models/*.onnx

# 检测识别引擎（yolo）的权重与字符表：仓库不分发，由用户下载/自训后放入。
# 只忽略权重本身，models/yolo/README.md 要留在库里（放置说明与许可义务）。
models/yolo/*.onnx
models/yolo/charset.txt

# 对抗退化样张（工具确定性生成，内存消费）
tests/baselines/hard/
